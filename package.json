{
  "name": "gigatable",
  "version": "1.4.0",
  "description": "Open-source, source-installed React data grid with editable cells, range selection, Excel-compatible copy/paste, fill, virtualization and undo/redo.",
  "keywords": [
    "react",
    "react-data-grid",
    "data-grid",
    "editable-table",
    "excel-like",
    "spreadsheet",
    "tanstack-table",
    "typescript",
    "virtualization",
    "copy-paste",
    "cell-selection",
    "fill-handle"
  ],
  "homepage": "https://gigatable.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikenahac/gigatable.git"
  },
  "bugs": {
    "url": "https://github.com/aikenahac/gigatable/issues"
  },
  "author": "Aiken Tine Ahac",
  "license": "MIT",
  "type": "module",
  "main": "src/index.tsx",
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.13.13",
    "clsx": "^2.1.1",
    "loader-utils": "^3.3.1",
    "mermaid": "^11.15.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "8.50.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.22",
    "eslint": "9.36.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.50.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/verify-seo.mjs",
    "generate-data": "tsx src/scripts/generate-data.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "skills:sync-agents": "node scripts/skills/sync-agent-registry.mjs",
    "skills:generate-installers": "node scripts/skills/generate-installers.mjs",
    "skills:validate": "node scripts/skills/validate.mjs",
    "skills:package": "node scripts/skills/package.mjs",
    "skills:test": "node --test scripts/skills/test-installers.mjs",
    "verify:ai-discovery": "node scripts/verify-ai-discovery.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "cli:deploy": "pnpm --dir gigatable exec tsx scripts/deploy.ts",
    "cli:prepare": "pnpm --dir gigatable exec tsx scripts/prepare.ts"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
